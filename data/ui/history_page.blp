using Gtk 4.0;
using Adw 1;

translation-domain 'io.github.d3msudo.anura';

template $HistoryPage : Adw.NavigationPage {
  title: _("Capture History");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      visible: true;

      [title]
      Adw.WindowTitle {
        title: _("Capture History");
      }

      [end]
      Button clear_button {
        icon-name: "user-trash-symbolic";
        tooltip-text: _("Clear history");
        action-name: "history.clear";
        accessibility {
          label: _("Clear history");
        }
      }
    }

    ScrolledWindow {
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;

      Adw.Clamp {
        maximum-size: 600;
        margin-top: 18;
        margin-bottom: 18;
        margin-start: 12;
        margin-end: 12;

        Box {
          orientation: vertical;
          spacing: 12;

          Stack status_stack {
            transition-type: crossfade;

            Box empty_state {
              orientation: vertical;
              spacing: 12;
              halign: center;
              valign: center;
              margin-top: 48;

              Image {
                icon-name: "document-open-recent-symbolic";
                pixel-size: 64;
                styles ["dim-label"]
              }

              Label {
                label: _("No capture history");
                styles ["title-2"]
              }

              Label {
                label: _("Your captured text will appear here.");
                styles ["dim-label"]
              }
            }

            ListBox history_list {
              selection-mode: none;
              styles ["boxed-list"]
            }
          }
        }
      }
    }
  }
}
