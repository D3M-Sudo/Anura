using Gtk 4.0;
using Gio 2.0;
using Adw 1;

translation-domain 'io.github.d3msudo.anura';

template $HistoryPage : Adw.NavigationPage {
  title: _("History");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar headerbar {
      [end]
      Button clear_btn {
        icon-name: "user-trash-symbolic";
        tooltip-text: _("Clear History");
        accessibility {
          label: _("Clear history");
        }
        clicked => $_on_clear_clicked();
        styles ["flat"]
      }
    }

    [top]
    Adw.Banner warning_banner {
      title: _("History is disabled — new captures won't be saved.");
      revealed: false;
    }

    Stack views_stack {
      hexpand: true;
      vexpand: true;

      StackPage {
        name: "empty_state";
        child: Adw.StatusPage {
          icon-name: "document-open-recent-symbolic";
          title: _("No Recent Captures");
          description: _("Your extracted text history will appear here.");
        };
      }

      StackPage {
        name: "list_state";
        child: ScrolledWindow {
          hexpand: true;
          vexpand: true;

          Adw.Clamp {
            maximum-size: 600;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            ListView list_view {
              enable-rubberband: false;
              single-click-activate: true;

              model: NoSelection selection {
                model: Gio.ListStore list_store {
                  item-type: typeof<$CaptureSession>;
                };
              };

              factory: SignalListItemFactory factory {
                setup => $_on_item_setup();
                bind => $_on_item_bind();
              };

              styles ["boxed-list", "card"]
            }
          }
        };
      }
    }
  }
}
