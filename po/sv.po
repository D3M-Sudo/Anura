#: anura/utils/portal_advice.py:86
msgid "LXQt"
msgstr "LXQt"

#: anura/utils/portal_advice.py:87
msgid ""
"Screenshot portal is not configured for LXQt. See the README for the LXQt "
"setup steps."
msgstr ""
"Skärmbildsportalen är inte konfigurerad för LXQt. Se README för "
"installationsstegen för LXQt."

#: anura/utils/portal_advice.py:89
msgid ""
"On LXQt, install xdg-desktop-portal-kde, then create ~/.config/xdg-desktop-"
"portal/lxqt-portals.conf with [preferred] org.freedesktop.impl.portal."
"Screenshot=kde, and restart the portal (systemctl --user restart xdg-desktop-"
"portal.service)."
msgstr ""
"I LXQt installerar du xdg-desktop-portal-kde, skapar sedan ~/.config/xdg-"
"desktop-portal/lxqt-portals.conf med [preferred] "
"org.freedesktop.impl.portal.Screenshot=kde och startar om portalen "
"(systemctl --user restart xdg-desktop-portal.service)."

#: anura/utils/portal_advice.py:100
msgid "KDE Plasma"
msgstr "KDE Plasma"

#: anura/utils/portal_advice.py:101
msgid ""
